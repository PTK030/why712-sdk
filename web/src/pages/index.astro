---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/site.css";
import "../styles/landing.css";

const base = `${import.meta.env.BASE_URL}/`;

const issueGroups = [
  {
    title: "Domain",
    copy: "Chain ID, verifying contract, name, version, salt, and the final domain separator.",
    code: "DOMAIN_*",
  },
  {
    title: "Types and encoding",
    copy: "Field order, integer widths, packed encoding, dynamic values, and signing envelopes.",
    code: "TYPE_* / ENCODING_*",
  },
  {
    title: "Signature",
    copy: "Recovered signer, v normalization, high-S values, ERC-2098, and ERC-1271 contracts.",
    code: "SIGNATURE_*",
  },
];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="why712 explains why an EIP-712 signature does not verify and shows the values that differ."
    />
    <meta name="theme-color" content="#f4f4f0" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>why712 — EIP-712 signature diagnostics</title>
  </head>
  <body>
    <SiteHeader base={base} active="home" />

    <main>
      <section class="hero">
        <div class="hero__copy">
          <p class="eyebrow">EIP-712 signature diagnostics</p>
          <h1>Find out why the signature does not verify.</h1>
          <p class="hero__summary">
            why712 recomputes the typed-data digest, recovers the signer, and compares the
            values that matter. You get a concrete explanation and the change needed to fix it.
          </p>
          <div class="hero__actions">
            <a class="button button--primary" href={`${base}app/`}>Diagnose in the browser</a>
            <a class="button button--secondary" href={`${base}docs/guides/getting-started/`}>
              Get started
            </a>
          </div>
          <p class="hero__note">No account, wallet connection, telemetry, or why712 backend.</p>
        </div>

        <div class="diagnosis-preview" aria-label="Example diagnosis">
          <div class="diagnosis-preview__header">
            <span>Example diagnosis</span>
            <code>permit.json</code>
          </div>
          <div class="diagnosis-preview__body">
            <p class="diagnosis-preview__label">The chain ID differs</p>
            <h2>Signed for chain 5.<br />Expected chain 1.</h2>
            <div class="diagnosis-preview__comparison">
              <div>
                <span>Expected</span>
                <strong>1</strong>
              </div>
              <div>
                <span>Signed</span>
                <strong>5</strong>
              </div>
            </div>
            <p class="diagnosis-preview__fix">
              Set <code>domain.chainId</code> to <code>1</code>, then sign the typed data again.
            </p>
            <div class="diagnosis-preview__meta">
              <span>DOMAIN_CHAIN_ID_MISMATCH</span>
              <span>Found by signer recovery</span>
            </div>
          </div>
        </div>
      </section>

      <section class="product-intro" aria-labelledby="product-intro-title">
        <p class="eyebrow">One clear result</p>
        <h2 id="product-intro-title">
          See the cause first.<br />Inspect every hash when you need it.
        </h2>
        <p>
          A report starts with the mismatch and the recommended change. The complete EIP-712
          computation remains available for review, automation, and audit work.
        </p>
      </section>

      <section class="workflow" aria-label="How why712 works">
        <article>
          <span>01</span>
          <h3>Add the failing request</h3>
          <p>Paste typed data or an <code>eth_signTypedData_v4</code> request and the public signature.</p>
        </article>
        <article>
          <span>02</span>
          <h3>Run the same Rust core</h3>
          <p>The browser and CLI use one deterministic engine to recompute and compare the inputs.</p>
        </article>
        <article>
          <span>03</span>
          <h3>Apply the specific fix</h3>
          <p>Review expected and actual values, then copy a reproducible report for your team.</p>
        </article>
      </section>

      <section class="coverage" aria-labelledby="coverage-title">
        <div class="coverage__heading">
          <p class="eyebrow">Focused on EIP-712</p>
          <h2 id="coverage-title">The common failure points, in one report.</h2>
        </div>
        <div class="coverage__list">
          {issueGroups.map((group) => (
            <article>
              <div>
                <h3>{group.title}</h3>
                <code>{group.code}</code>
              </div>
              <p>{group.copy}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="surfaces" aria-labelledby="surfaces-title">
        <div class="surfaces__copy">
          <p class="eyebrow">Use it your way</p>
          <h2 id="surfaces-title">Browser for a quick check. CLI for your workflow.</h2>
          <p>
            The playground is ready without installation. The CLI works with files, standard
            input, private RPC endpoints, JSON output, Markdown reports, and CI.
          </p>
          <a href={`${base}docs/guides/cli/`}>Read the CLI reference</a>
        </div>
        <div class="command-card">
          <div class="command-card__top">
            <span>Terminal</span>
            <span>Offline</span>
          </div>
          <pre><code>why712 check \
  --typed-data permit.json \
  --signature 0x... \
  --signer 0x... \
  --offline</code></pre>
          <div class="command-card__result">
            <span>DOMAIN_CHAIN_ID_MISMATCH</span>
            <strong>Set domain.chainId to 1.</strong>
          </div>
        </div>
      </section>

      <section class="privacy" aria-labelledby="privacy-title">
        <div>
          <p class="eyebrow">A small, explicit network boundary</p>
          <h2 id="privacy-title">Your input stays local by default.</h2>
        </div>
        <div class="privacy__body">
          <p>
            Offline diagnosis performs no network I/O. When you request contract evidence, the
            browser contacts only the RPC endpoint you selected, directly.
          </p>
          <div class="privacy__flow" aria-label="Data flow">
            <span>Typed data</span>
            <span aria-hidden="true">→</span>
            <span>Local WASM</span>
            <span aria-hidden="true">→</span>
            <span>Report</span>
          </div>
          <a href={`${base}docs/guides/privacy/`}>Read the privacy and security guide</a>
        </div>
      </section>

      <section class="final-cta">
        <h2>Start with the failing signature.</h2>
        <p>Use a bundled example or paste your own EIP-712 request.</p>
        <a class="button button--primary" href={`${base}app/`}>Open the playground</a>
      </section>
    </main>

    <SiteFooter base={base} />
  </body>
</html>
