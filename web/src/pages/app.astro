---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/site.css";
import "../styles/playground.css";

const base = `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Diagnose EIP-712 signature mismatches locally in your browser."
    />
    <meta name="theme-color" content="#f4f4f0" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>Playground — why712</title>
  </head>
  <body>
    <SiteHeader base={base} active="app" compact />

    <main class="playground">
      <header class="playground__intro">
        <div>
          <p class="eyebrow">Browser playground</p>
          <h1>Diagnose an EIP-712 signature.</h1>
        </div>
        <p>
          Processing happens locally with WebAssembly. A network request is made only when you
          provide both a contract and an RPC endpoint.
        </p>
      </header>

      <section class="workspace" aria-label="Diagnostic workspace">
        <form id="diagnose-form" class="input-panel">
          <div class="panel-heading">
            <div>
              <span class="step">Input</span>
              <h2>Signature data</h2>
            </div>
            <button id="clear-button" class="text-button" type="button">Clear</button>
          </div>

          <div class="format-row">
            <label class="field">
              <span>Input format</span>
              <select id="input-format" name="inputFormat">
                <option value="typed-data">Typed data</option>
                <option value="wallet-request">Wallet request (eth_signTypedData_v4)</option>
              </select>
            </label>
          </div>

          <div class="example-strip" aria-labelledby="examples-label">
            <p id="examples-label">Load an example</p>
            <div id="example-list" class="example-list" aria-live="polite">
              <span class="loading-label">Loading examples…</span>
            </div>
          </div>

          <label class="field field-large">
            <span id="typed-data-label">EIP-712 typed data <strong>required</strong></span>
            <textarea
              id="typed-data"
              name="typedData"
              rows="17"
              spellcheck="false"
              placeholder='{"types":{…},"primaryType":"…","domain":{…},"message":{…}}'
              required
            ></textarea>
          </label>

          <label class="field">
            <span>Signature</span>
            <input id="signature" name="signature" type="text" spellcheck="false" placeholder="0x…">
          </label>

          <div class="field-grid">
            <label class="field">
              <span>Expected signer</span>
              <input id="signer" name="signer" type="text" spellcheck="false" placeholder="0x…">
            </label>
            <label class="field">
              <span>Verifying contract</span>
              <input id="contract" name="contract" type="text" spellcheck="false" placeholder="0x…">
            </label>
          </div>

          <details class="network-options">
            <summary>Optional contract evidence</summary>
            <div class="field-grid network-fields">
              <label class="field">
                <span>RPC endpoint</span>
                <input
                  id="rpc-url"
                  name="rpcUrl"
                  type="url"
                  value="https://ethereum-rpc.publicnode.com"
                  placeholder="https://your-endpoint.example"
                >
                <small>
                  Contacted directly from this tab. Clear the field to keep the diagnosis offline.
                </small>
              </label>
              <label class="field">
                <span>ERC-6492 validator <small>optional</small></span>
                <input
                  id="erc6492-validator"
                  name="erc6492Validator"
                  type="text"
                  spellcheck="false"
                  placeholder="0x…"
                >
              </label>
              <label class="field">
                <span>Candidate chain ID</span>
                <input id="chain-id" name="chainId" type="number" min="0" step="1" placeholder="1">
              </label>
            </div>
          </details>

          <div class="form-actions">
            <button id="diagnose-button" class="primary-button" type="submit">
              <span>Diagnose signature</span>
              <span aria-hidden="true">→</span>
            </button>
            <p id="form-status" class="form-status" role="status"></p>
          </div>
        </form>

        <section class="result-panel" aria-labelledby="result-title">
          <div class="panel-heading">
            <div>
              <span class="step">Result</span>
              <h2 id="result-title">Diagnosis</h2>
            </div>
            <span id="engine-status" class="engine-status">Loading engine</span>
          </div>

          <div id="empty-result" class="empty-result">
            <h3>No report yet</h3>
            <p>Load an example or add your own request, then run the diagnosis.</p>
          </div>

          <div id="report" class="report" hidden>
            <div id="verdict-card" class="verdict-card">
              <div>
                <p>Verdict</p>
                <h3 id="verdict-label"></h3>
              </div>
              <p id="verdict-summary"></p>
            </div>

            <div class="report-actions">
              <button id="copy-markdown" class="secondary-button" type="button">
                Copy as Markdown
              </button>
              <button id="copy-link" class="secondary-button" type="button">Copy link</button>
            </div>

            <section class="report-section report-section--findings" aria-labelledby="differences-title">
              <div class="section-heading">
                <h3 id="differences-title">What differs</h3>
                <span id="finding-count"></span>
              </div>
              <div id="finding-list" class="finding-list"></div>
            </section>

            <section class="report-section" aria-labelledby="signer-title">
              <h3 id="signer-title">Signer recovery</h3>
              <dl id="signer-grid" class="value-grid"></dl>
            </section>

            <section class="report-section" aria-labelledby="context-title">
              <h3 id="context-title">Input and contract state</h3>
              <dl id="context-grid" class="value-grid"></dl>
            </section>

            <section class="report-section" aria-labelledby="computed-title">
              <h3 id="computed-title">EIP-712 computation</h3>
              <dl id="computed-grid" class="value-grid"></dl>
            </section>
          </div>
        </section>
      </section>

      <p class="playground__safety">
        Never paste a private key or seed phrase. Review typed data before copying a share link.
      </p>
    </main>

    <SiteFooter base={base} />
    <div id="toast" class="toast" role="status" aria-live="polite"></div>
    <script is:inline type="module" src={`${base}app/app.js`}></script>
  </body>
</html>
