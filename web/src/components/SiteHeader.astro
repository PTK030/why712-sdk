---
import logo from "../assets/logo.svg";

interface Props {
  base: string;
  active?: "home" | "app" | "docs";
  compact?: boolean;
}

const { base, active = "home", compact = false } = Astro.props;
---

<header class:list={["site-header", { "site-header--compact": compact }]}>
  <a class="site-brand" href={base} aria-label="why712 home">
    <img src={logo.src} width="34" height="34" alt="" />
    <span>why712</span>
  </a>
  <nav class="site-nav" aria-label="Primary navigation">
    <a class:list={{ active: active === "docs" }} href={`${base}docs/guides/overview/`}>Docs</a>
    <a href="https://github.com/PTK030/why712">GitHub</a>
    <a
      class:list={["site-nav__cta", { active: active === "app" }]}
      href={`${base}app/`}
    >
      Open playground
    </a>
  </nav>
</header>
